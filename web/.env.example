# STB-Proxy web viewer — BFF configuration.
# Copy to /etc/stb-proxy-web/env (root-owned, chmod 600) and fill the secrets.
# systemd loads it via EnvironmentFile; nothing here is committed with real values.

# Upstream STB-Proxy, int-only. Never reaches the browser.
PROXY_URL=http://192.168.5.71:8001

# Public origin of this client (used for Origin checks and the Secure cookie).
PUBLIC_ORIGIN=https://watch.home.gregfroese.com

# Secret material. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET=
FERNET_KEY=
# Optional rotation: comma-separated old keys, newest first. See MultiFernet.
FERNET_KEYS_FALLBACK=

# TTLs (seconds).
LINEUP_TTL=30
EPG_TTL=300
IDLE=3600
ABS=43200
REVALIDATE=900

# Where the session SQLite lives.
SESSION_DB=/var/lib/stb-proxy-web/sessions.db

# Built SPA assets (defaults to ../app/dist relative to the bff package).
STATIC_DIR=

# Set to false ONLY for local http dev (disables the __Host- cookie prefix).
COOKIE_SECURE=true

# Upstream request timeouts (seconds).
REQUEST_TIMEOUT=15
STREAM_TIMEOUT=30
